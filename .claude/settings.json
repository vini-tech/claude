{
  "permissions": {
    "allow": [
      "Bash(node tests/validar_temas.js)",
      "Bash(node tests/validar_temas.js:*)",
      "Bash(node tests/medir_texto.js:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar.js\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
