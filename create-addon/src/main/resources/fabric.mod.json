{
  "schemaVersion": 1,
  "id": "create_synthesis",
  "version": "${version}",

  "name": "Create: Synthesis",
  "description": "Synthesize the unsynthesizable: Create production routes for every item that has no crafting recipe.",
  "authors": [ "vini-tech" ],
  "license": "MIT",
  "icon": "assets/create_synthesis/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [ "com.vinitech.createsynthesis.CreateSynthesis" ],
    "client": [ "com.vinitech.createsynthesis.CreateSynthesisClient" ]
  },

  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "create": ">=${create_version}"
  }
}
